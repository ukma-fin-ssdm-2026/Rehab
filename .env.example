# Copy to .env and replace both placeholder passwords.
REHAB_DEV_DB_PORT=25432
REHAB_TEST_DB_PORT=25433
REHAB_DEV_DB_PASSWORD=replace_with_random_dev_password
REHAB_TEST_DB_PASSWORD=replace_with_different_random_test_password

# Use matching passwords and ports in these URLs.
DATABASE_URL=postgresql+psycopg://rehab_dev:replace_with_random_dev_password@127.0.0.1:25432/rehab_dev
TEST_DATABASE_URL=postgresql+psycopg://rehab_test:replace_with_different_random_test_password@127.0.0.1:25433/rehab_test

# Local API auth/CORS; replace JWT placeholder before running the API.
JWT_SECRET=replace_with_random_secret_at_least_32_characters
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Optional daily-reminder job and Gmail API. Keep real values private.
REMINDERS_JOB_TOKEN=
MAIL_FROM=rehab.support.web@gmail.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

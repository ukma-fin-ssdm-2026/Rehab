@startuml
title Діаграма розгортання системи "Рехаб"

rectangle "ТВ-1: Клієнтська зона (недовірена)" {
  node "Користувацький пристрій" {
    component "Web Browser" as Browser
  }
}

rectangle "ТВ-2: Серверна зона (довірена)" {
  node "Сервер застосунку" {
    component "Web Frontend" as Front
    component "REST API Backend\n(Layered Monolith,\nAuth/RBAC, Rate Limiting)" as API
  }
}

rectangle "ТВ-3: Зона зберігання даних" {
  node "Сервер БД" {
    database "PostgreSQL" as DB
  }
}

Browser --> Front : HTTPS
Front --> API : REST API / JSON\n(JWT)
API --> DB : SQL (TLS,\nConnection Pool)
@enduml

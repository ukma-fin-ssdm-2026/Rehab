@startuml
!pragma layout smetana
title Реалізовані компоненти Rehab — реліз КТ3
component "Expo Web\nКалендар / деталі / форми" as Front
component "apiRequest\nJWT поточної сесії" as Client
package "FastAPI" {
 component "Auth / RBAC" as Auth
 component "calendar_postgres\nPOST / GET / PATCH" as Calendar
 component "Цілі / статистика / admin" as Other
 component "progress_sync\nперерахунок у транзакції" as Progress
 component "Repositories / SQLAlchemy" as Repo
}
database "PostgreSQL\nusers, day_records\ngoals: legacy, не використовується\nНапої: JSONB" as DB
Front --> Client
Client --> Auth : HTTPS / JSON
Client --> Calendar : JWT
Client --> Other : JWT
Calendar --> Auth : власник
Calendar --> Progress : POST / PATCH
Calendar --> Repo
Progress --> Repo
Other --> Repo
Auth --> Repo
Repo --> DB : psycopg
note bottom of DB
 Neon онлайн; окремі dev/test БД Compose локально.
 Менторство й сповіщення — майбутні компоненти.
end note
@enduml
